-- ============================================
-- Database Schema - E-commerce Sayur (SayurKu)
-- Database: MySQL 8.0+
-- ============================================
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

SET NAMES utf8mb4;
SET FOREIGN_KEY_CHECKS = 0;

-- ============================================
-- USERS & AUTH
-- ============================================

CREATE TABLE users (
  id            CHAR(36)      NOT NULL DEFAULT (UUID()),
  name          VARCHAR(255)  NOT NULL,
  email         VARCHAR(255)  NOT NULL,
  password_hash VARCHAR(255)  NOT NULL,
  phone         VARCHAR(20)   NULL,
  address       TEXT          NULL,
  role          ENUM('CUSTOMER', 'ADMIN') NOT NULL DEFAULT 'CUSTOMER',
  created_at    TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at    TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  UNIQUE KEY uq_users_email (email)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================================
-- KATEGORI
-- ============================================

CREATE TABLE categories (
  id         CHAR(36)     NOT NULL DEFAULT (UUID()),
  name       VARCHAR(100) NOT NULL,
  slug       VARCHAR(100) NOT NULL,
  created_at TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  UNIQUE KEY uq_categories_slug (slug)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================================
-- PRODUK
-- ============================================

CREATE TABLE products (
  id              CHAR(36)      NOT NULL DEFAULT (UUID()),
  name            VARCHAR(255)  NOT NULL,
  slug            VARCHAR(255)  NOT NULL,
  description     TEXT          NULL,
  price           DECIMAL(10,2) NOT NULL,
  unit            ENUM('GRAM', 'KG', 'IKAT', 'PCS') NOT NULL,
  weight_per_unit VARCHAR(50)   NULL,               -- contoh: "1 ikat ± 250g"
  stock           INT           NOT NULL DEFAULT 0,
  images          JSON          NULL,               -- array URL dari Cloudinary
  is_organic      BOOLEAN       NOT NULL DEFAULT FALSE,
  origin          VARCHAR(150)  NULL,               -- contoh: "Lembang, Jawa Barat"
  status          ENUM('AKTIF', 'NONAKTIF', 'HABIS') NOT NULL DEFAULT 'AKTIF',
  sold_count      INT           NOT NULL DEFAULT 0,
  rating_avg      DECIMAL(2,1)  NOT NULL DEFAULT 0,
  review_count    INT           NOT NULL DEFAULT 0,
  category_id     CHAR(36)      NOT NULL,
  created_at      TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at      TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  UNIQUE KEY uq_products_slug (slug),
  KEY idx_products_category (category_id),
  KEY idx_products_name (name),
  CONSTRAINT fk_products_category
    FOREIGN KEY (category_id) REFERENCES categories(id)
    ON DELETE RESTRICT ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================================
-- PAKET MENU MASAKAN (fitur diferensiasi)
-- ============================================

CREATE TABLE paket_menu (
  id          CHAR(36)      NOT NULL DEFAULT (UUID()),
  name        VARCHAR(150)  NOT NULL,               -- contoh: "Paket Sayur Sop"
  slug        VARCHAR(150)  NOT NULL,
  description TEXT          NULL,
  price       DECIMAL(10,2) NOT NULL,
  image       VARCHAR(500)  NULL,
  created_at  TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at  TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  UNIQUE KEY uq_paket_menu_slug (slug)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE paket_menu_items (
  id            CHAR(36) NOT NULL DEFAULT (UUID()),
  quantity      INT      NOT NULL DEFAULT 1,
  paket_menu_id CHAR(36) NOT NULL,
  product_id    CHAR(36) NOT NULL,
  PRIMARY KEY (id),
  UNIQUE KEY uq_paket_menu_product (paket_menu_id, product_id),
  KEY idx_pmi_product (product_id),
  CONSTRAINT fk_pmi_paket_menu
    FOREIGN KEY (paket_menu_id) REFERENCES paket_menu(id)
    ON DELETE CASCADE ON UPDATE CASCADE,
  CONSTRAINT fk_pmi_product
    FOREIGN KEY (product_id) REFERENCES products(id)
    ON DELETE RESTRICT ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================================
-- RATING & REVIEW
-- ============================================

CREATE TABLE reviews (
  id         CHAR(36) NOT NULL DEFAULT (UUID()),
  rating     TINYINT  NOT NULL,                     -- 1-5
  comment    TEXT     NULL,
  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  user_id    CHAR(36) NOT NULL,
  product_id CHAR(36) NOT NULL,
  PRIMARY KEY (id),
  UNIQUE KEY uq_review_user_product (user_id, product_id),  -- 1 user 1 review per produk
  KEY idx_reviews_product (product_id),
  CONSTRAINT chk_reviews_rating CHECK (rating BETWEEN 1 AND 5),
  CONSTRAINT fk_reviews_user
    FOREIGN KEY (user_id) REFERENCES users(id)
    ON DELETE RESTRICT ON UPDATE CASCADE,
  CONSTRAINT fk_reviews_product
    FOREIGN KEY (product_id) REFERENCES products(id)
    ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================================
-- WISHLIST
-- ============================================

CREATE TABLE wishlists (
  id         CHAR(36) NOT NULL DEFAULT (UUID()),
  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  user_id    CHAR(36) NOT NULL,
  product_id CHAR(36) NOT NULL,
  PRIMARY KEY (id),
  UNIQUE KEY uq_wishlist_user_product (user_id, product_id),
  KEY idx_wishlist_product (product_id),
  CONSTRAINT fk_wishlist_user
    FOREIGN KEY (user_id) REFERENCES users(id)
    ON DELETE CASCADE ON UPDATE CASCADE,
  CONSTRAINT fk_wishlist_product
    FOREIGN KEY (product_id) REFERENCES products(id)
    ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================================
-- ORDER (CHECKOUT)
-- ============================================

CREATE TABLE orders (
  id                      CHAR(36)      NOT NULL DEFAULT (UUID()),
  order_number            VARCHAR(50)   NOT NULL,   -- contoh: "ORD-20260914-0001"
  status                  ENUM('PENDING', 'DIPROSES', 'DIKIRIM', 'SELESAI', 'DIBATALKAN')
                                        NOT NULL DEFAULT 'PENDING',
  total_amount            DECIMAL(10,2) NOT NULL,
  shipping_address        TEXT          NOT NULL,
  shipping_schedule       VARCHAR(100)  NULL,       -- contoh: "Pagi, 07.00 - 09.00"
  payment_method          VARCHAR(50)   NULL,       -- contoh: "Gopay", "Bank Transfer"
  payment_status          ENUM('MENUNGGU', 'BERHASIL', 'GAGAL')
                                        NOT NULL DEFAULT 'MENUNGGU',
  midtrans_transaction_id VARCHAR(100)  NULL,
  created_at              TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at              TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  user_id                 CHAR(36)      NOT NULL,
  PRIMARY KEY (id),
  UNIQUE KEY uq_orders_order_number (order_number),
  UNIQUE KEY uq_orders_midtrans_trx (midtrans_transaction_id),
  KEY idx_orders_user (user_id),
  CONSTRAINT fk_orders_user
    FOREIGN KEY (user_id) REFERENCES users(id)
    ON DELETE RESTRICT ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE order_items (
  id                CHAR(36)      NOT NULL DEFAULT (UUID()),
  quantity          INT           NOT NULL,
  price_at_purchase DECIMAL(10,2) NOT NULL,          -- snapshot harga saat transaksi
  subtotal          DECIMAL(10,2) NOT NULL,
  order_id          CHAR(36)      NOT NULL,
  product_id        CHAR(36)      NOT NULL,
  PRIMARY KEY (id),
  KEY idx_order_items_order (order_id),
  KEY idx_order_items_product (product_id),
  CONSTRAINT fk_order_items_order
    FOREIGN KEY (order_id) REFERENCES orders(id)
    ON DELETE CASCADE ON UPDATE CASCADE,
  CONSTRAINT fk_order_items_product
    FOREIGN KEY (product_id) REFERENCES products(id)
    ON DELETE RESTRICT ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

SET FOREIGN_KEY_CHECKS = 1;