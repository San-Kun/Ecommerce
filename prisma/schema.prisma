// ============================================
// SayurKu - Prisma Schema
// Database: MySQL 8.0+
// ID strategy: UUID (CHAR(36))
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  USER
  ADMIN
}

enum ProductUnit {
  GRAM
  KG
  IKAT
  PCS
}

enum ProductStatus {
  AKTIF
  NONAKTIF
  HABIS
}

enum OrderStatus {
  PENDING
  DIPROSES
  DIKIRIM
  SELESAI
  DIBATALKAN
}

enum PaymentStatus {
  MENUNGGU
  BERHASIL
  GAGAL
}

enum VoucherType {
  PERCENT // potongan persentase (value = persen, mis. 10 = 10%)
  FIXED   // potongan nominal tetap (value = rupiah)
}

// ============================================
// USERS & ADDRESSES
// ============================================

model User {
  id           String   @id @default(uuid()) @db.Char(36)
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  phone        String?  @db.VarChar(20)
  role         Role     @default(USER)
  tokenVersion Int      @default(0) @map("token_version") // dinaikkan saat logout utk revoke refresh token lama
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  addresses Address[]
  reviews   Review[]
  wishlists Wishlist[]
  orders    Order[]
  cart      Cart?
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// ============================================
// RESET PASSWORD
// ============================================

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Char(36)
  tokenHash String   @unique @map("token_hash") @db.VarChar(255) // simpan hash token, bukan token mentah
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id") @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Address {
  id          String   @id @default(uuid()) @db.Char(36)
  label       String   @db.VarChar(100) // contoh: "Rumah", "Kantor"
  fullAddress String   @map("full_address") @db.Text
  latitude    Decimal  @db.Decimal(10, 7)
  longitude   Decimal  @db.Decimal(10, 7)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userId String @map("user_id") @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ============================================
// KATEGORI & PRODUK
// ============================================

model Category {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Product {
  id            String        @id @default(uuid()) @db.Char(36)
  name          String        @db.VarChar(255)
  slug          String        @unique @db.VarChar(255)
  description   String?       @db.Text
  price         Decimal       @db.Decimal(10, 2)
  unit          ProductUnit
  weightPerUnit String?       @map("weight_per_unit") @db.VarChar(50) // contoh: "1 ikat ± 250g"
  stepQuantity  Decimal       @default(1) @map("step_quantity") @db.Decimal(6, 2) // increment beli, mis. 0.25 utk kg
  minOrderQty   Decimal       @default(1) @map("min_order_qty") @db.Decimal(6, 2)
  stock         Int           @default(0)
  images        Json? // array URL Cloudinary
  isOrganic     Boolean       @default(false) @map("is_organic")
  origin        String?       @db.VarChar(150) // contoh: "Lembang, Jawa Barat"
  status        ProductStatus @default(AKTIF)
  soldCount     Int           @default(0) @map("sold_count")
  ratingAvg     Decimal       @default(0) @map("rating_avg") @db.Decimal(2, 1)
  reviewCount   Int           @default(0) @map("review_count")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  categoryId String   @map("category_id") @db.Char(36)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  reviews         Review[]
  wishlists       Wishlist[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  paketMenuItems  PaketMenuItem[]

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

// ============================================
// PAKET MENU MASAKAN (fitur diferensiasi)
// ============================================

model PaketMenu {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @db.VarChar(150) // contoh: "Paket Sayur Sop"
  slug        String   @unique @db.VarChar(150)
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  image       String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items PaketMenuItem[]

  @@map("paket_menu")
}

model PaketMenuItem {
  id       String @id @default(uuid()) @db.Char(36)
  quantity Int    @default(1)

  paketMenuId String    @map("paket_menu_id") @db.Char(36)
  paketMenu   PaketMenu @relation(fields: [paketMenuId], references: [id], onDelete: Cascade)

  productId String  @map("product_id") @db.Char(36)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([paketMenuId, productId])
  @@index([productId])
  @@map("paket_menu_items")
}

// ============================================
// RATING & REVIEW
// ============================================

model Review {
  id        String   @id @default(uuid()) @db.Char(36)
  rating    Int      @db.TinyInt // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id") @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  productId String  @map("product_id") @db.Char(36)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // 1 user 1 review per produk
  @@index([productId])
  @@map("reviews")
}

// ============================================
// WISHLIST
// ============================================

model Wishlist {
  id        String   @id @default(uuid()) @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id") @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String  @map("product_id") @db.Char(36)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("wishlists")
}

// ============================================
// CART (persisten, bukan cuma di client state)
// ============================================

model Cart {
  id        String   @id @default(uuid()) @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @unique @map("user_id") @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id       String  @id @default(uuid()) @db.Char(36)
  quantity Decimal @db.Decimal(6, 2) // desimal krn ada satuan kg (mis. 0.5 kg)

  cartId String @map("cart_id") @db.Char(36)
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String  @map("product_id") @db.Char(36)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

// ============================================
// ORDER (CHECKOUT)
// ============================================

model Order {
  id                    String        @id @default(uuid()) @db.Char(36)
  orderNumber           String        @unique @map("order_number") @db.VarChar(50) // "ORD-20260914-0001"
  status                OrderStatus   @default(PENDING)
  subtotalAmount        Decimal       @map("subtotal_amount") @db.Decimal(10, 2)
  shippingCost          Decimal       @map("shipping_cost") @db.Decimal(10, 2)
  discountAmount        Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2) // potongan dari voucher
  voucherCode           String?       @map("voucher_code") @db.VarChar(50) // snapshot kode voucher yang dipakai
  totalAmount           Decimal       @map("total_amount") @db.Decimal(10, 2)
  shippingSchedule      String?       @map("shipping_schedule") @db.VarChar(100) // "Pagi, 07.00 - 09.00"
  paymentMethod         String?       @map("payment_method") @db.VarChar(50) // "Gopay", "Bank Transfer"
  paymentStatus         PaymentStatus @default(MENUNGGU) @map("payment_status")
  midtransTransactionId String?       @unique @map("midtrans_transaction_id") @db.VarChar(100)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  userId String @map("user_id") @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  addressId String  @map("address_id") @db.Char(36)
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  items OrderItem[]

  @@index([userId])
  @@index([addressId])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(uuid()) @db.Char(36)
  quantity        Decimal @db.Decimal(6, 2)
  priceAtPurchase Decimal @map("price_at_purchase") @db.Decimal(10, 2) // snapshot harga saat transaksi
  subtotal        Decimal @db.Decimal(10, 2)

  orderId String @map("order_id") @db.Char(36)
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String  @map("product_id") @db.Char(36)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ============================================
// VOUCHER / KUPON DISKON
// ============================================

model Voucher {
  id           String      @id @default(uuid()) @db.Char(36)
  code         String      @unique @db.VarChar(50) // kode yang diketik user, mis. "HEMAT10"
  description  String?     @db.VarChar(255)
  type         VoucherType @default(PERCENT)
  value        Decimal     @db.Decimal(10, 2) // persen (utk PERCENT) atau rupiah (utk FIXED)
  minSpend     Decimal     @default(0) @map("min_spend") @db.Decimal(10, 2) // minimal subtotal agar bisa dipakai
  maxDiscount  Decimal?    @map("max_discount") @db.Decimal(10, 2) // batas potongan (khusus PERCENT), null = tanpa batas
  isActive     Boolean     @default(true) @map("is_active")
  expiresAt    DateTime?   @map("expires_at") // null = tanpa kadaluarsa
  usageLimit   Int?        @map("usage_limit") // total maksimal pemakaian, null = tak terbatas
  usedCount    Int         @default(0) @map("used_count")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("vouchers")
}
